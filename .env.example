# ==============================================================================
# Department Cup 2026 - Environment Variables Template
# ==============================================================================
# Copy these variables into your Vercel Project Settings > Environment Variables:

# 1. MongoDB Atlas Connection URI (Required for persistent storage across serverless functions)
MONGO_URI="mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority"
DATABASE_NAME="department_cup"

# 2. Secret Key for signing session cookies
SECRET_KEY="generate-a-strong-random-secret-key-here"

# 3. Google OAuth 2.0 Credentials (from Google Cloud Console)
GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-client-secret"

# 4. OAuth Redirect URIs
# In production on Vercel, set these to your deployment URL:
# (If omitted, the app will auto-detect from VERCEL_URL)
GOOGLE_REDIRECT_URI_AUDIENCE="https://your-deployment-domain.vercel.app/"
GOOGLE_REDIRECT_URI_ADMIN="https://your-deployment-domain.vercel.app/admin"

# Note: Remember to add both URIs above to "Authorized redirect URIs" in
# Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client IDs.
